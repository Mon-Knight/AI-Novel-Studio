      "id": "context.read",
      "name": "context.read",
      "version": "1",
      "description": "读取已采用正文、章节总结和上下文记录的可审计快照。",
      "inputSchema": {
        "type": "object",
        "required": ["novelId", "chapterId"],
        "additionalProperties": false,
        "properties": {
          "novelId": {
            "type": "string",
            "description": "目标作品 ID",
            "minLength": 1,
            "maxLength": 160
          },
          "chapterId": {
            "type": "string",
            "description": "目标章节 ID",
            "minLength": 1,
            "maxLength": 160
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "可选的记忆检索词"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["ok", "source", "storageMode", "warnings"],
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_SCOPE",
                  "INVALID_ARGUMENT",
                  "PERMISSION_DENIED",
                  "SCOPE_MISMATCH",
                  "NOT_FOUND",
                  "INTEGRITY_ERROR",
                  "CONFIRMATION_REQUIRED",
                  "MODEL_SNAPSHOT_REQUIRED",
                  "CANDIDATE_ONLY",
                  "UPSTREAM_FAILURE",
                  "CONFLICT"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "retryable": {
                "type": "boolean"
              }
            }
          },
          "source": {
            "type": "string",
            "enum": ["sqlite", "localstorage", "runtime", "artifact"]
          },
          "storageMode": {
            "type": "string",
            "enum": ["sqlite", "browser_fallback", "runtime", "artifact"]
          },
          "warnings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "revision": {},
          "contentHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "scope": "chapter",
      "permissions": ["novel.read", "chapter.read"],
      "sideEffect": "none",
      "confirmationPolicy": "never",
      "timeoutMs": 30000,
      "exposure": "catalog_only",
