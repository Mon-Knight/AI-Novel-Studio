{
  "name": "ai-novel-studio",
  "private": true,
  "version": "2.6.1",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "test": "node --experimental-strip-types --test src/features/workspace/documentSafety.test.mjs src/services/backup/projectBackupService.test.mjs src/services/tauri/e2eBridgeSecurity.test.mjs && tsx --test --test-concurrency=1 scripts/e2e/artifact-sanitizer.test.ts src/services/context/chapterContextPersistence.test.ts src/components/workspace/EditorArea.test.tsx src/features/quality/qualityRequestSafety.test.ts src/services/generation/generationJobService.test.ts src/services/ai/aiCancellation.test.ts src/services/ai/compilation/executionContractCompiler.test.ts src/services/ai/aiExecutionPipeline.test.ts src/services/agent-tools/toolRegistry.test.ts src/services/agent-planner/agentPlanRuntimeService.test.ts src/services/placements/placementRuntimeService.test.ts src/services/quality/qualityCheckService.test.ts src/services/multi-agent/multiAgentService.test.ts",
    "test:workspace-safety": "node --experimental-strip-types --test src/features/workspace/documentSafety.test.mjs",
    "test:components": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/run_workspace_test_suite.ps1 -Suite components",
    "test:workspace-reliability": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/run_workspace_test_suite.ps1 -Suite workspace-reliability",
    "test:workspace-recovery": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/run_workspace_test_suite.ps1 -Suite workspace-recovery",
    "test:large-text-integrity": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/run_workspace_test_suite.ps1 -Suite large-text-integrity",
    "test:migrations": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/run_workspace_test_suite.ps1 -Suite migrations",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "test:setting-suggestions": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/check_setting_suggestions.ps1",
    "test:quality-workspace": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/check_quality_workspace.ps1",
    "test:ai-tasks-delete": "npm run test:ai-tasks-delete:static && npm run test:ai-tasks-delete:runtime",
    "test:ai-tasks-delete:static": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/check_ai_task_delete.ps1",
    "test:ai-tasks-delete:runtime": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/runtime_check_ai_task_delete.ps1",
    "test:project-backup": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/runtime_check_project_backup.ps1",
    "test:version-sync": "powershell -ExecutionPolicy Bypass -File scripts/agent-workflow/check_version_sync.ps1",
    "test:e2e": "tsx scripts/e2e/run-e2e.ts",
    "test:e2e:smoke": "tsx scripts/e2e/run-e2e.ts --smoke"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/types": "9.29.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "26.1.0",
    "tsx": "4.23.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "3.2.4"
  }
}
